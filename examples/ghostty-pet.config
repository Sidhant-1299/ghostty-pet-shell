# Ghostty Terminal Pet config
# Copy this to:
# ~/.config/ghostty-pet/config

GHOSTTY_PET_HOME="$HOME/.local/share/ghostty-pet"

# Path to the sprite sheet.
PET_IMAGE="$HOME/.config/ghostty-pet/pet.png"

# Exact Python interpreter that can import PIL.
# The installer should fill this in.
PYTHON_BIN="/Library/Frameworks/Python.framework/Versions/3.12/bin/python3"

# Shell to enter after the splash.
SHELL_BIN="${SHELL:-/bin/zsh}"

# Splash behavior.
SPLASH_SECONDS="5"
EXIT_ANY_KEY="1"

# Sprite sheet layout.
# Default generated sheet is 4 columns x 2 rows.
SHEET_COLS="4"
SHEET_ROWS="2"

# Animation settings.
FPS="7"

# Terminal cell footprint.
CELL_COLS="12"
CELL_ROWS="8"

# Pixel width after scaling each frame.
PIXEL_WIDTH="150"

# White/off-white background removal.
# Higher means more aggressive transparent background cleanup.
TRANSPARENT_THRESHOLD="245"

# Debug logs go to:
# ~/.config/ghostty-pet/debug.log
DEBUG="0"